// Esquema do banco da Casa de Leilões.
// Convenções:
//  - Valores monetários são inteiros em CENTAVOS (nunca float).
//  - Tabelas/colunas em snake_case no banco; camelCase no código (via @map/@@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUCTIONEER // Leiloeiro: cria e gerencia lotes; não dá lances
  BIDDER // Licitante: deposita saldo, dá lances e arremata
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wallet         Wallet?
  createdLots    Lot[]     @relation("AuctioneerLots")
  wonLots        Lot[]     @relation("WinningBidderLots")
  bids           Bid[]
  wonReceipts    Receipt[] @relation("WinnerReceipts")
  issuedReceipts Receipt[] @relation("AuctioneerReceipts")

  @@map("users")
}

/// Carteira simulada. `balanceCents` é o saldo TOTAL.
/// O saldo comprometido não é armazenado: é derivado dos lotes abertos em que o
/// usuário lidera, o que evita divergência entre duas fontes de verdade.
model Wallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  balanceCents BigInt   @default(0) @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTransactionType {
  DEPOSIT // Depósito simulado do licitante
  SETTLEMENT_DEBIT // Débito do vencedor ao liquidar um lote
  SETTLEMENT_CREDIT // Crédito ao leiloeiro ao liquidar um lote
}

/// Livro-razão (append-only) de movimentações da carteira.
model WalletTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  walletId          String                @map("wallet_id") @db.Uuid
  type              WalletTransactionType
  /// Valor com sinal: positivo = entrada, negativo = saída.
  amountCents       BigInt                @map("amount_cents")
  balanceAfterCents BigInt                @map("balance_after_cents")
  description       String?               @db.VarChar(255)
  createdAt         DateTime              @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum LotStatus {
  SCHEDULED // Agendado (startsAt no futuro)
  ACTIVE // Ao vivo (startsAt <= agora < endsAt)
  FINISHED // Encerrado (agora >= endsAt)
  CANCELLED // Cancelado pelo leiloeiro (apenas se sem lances)
}

/// Lote de leilão.
/// Contém o snapshot completo dos dados da obra no momento da criação,
/// garantindo resiliência total mesmo se a API externa de arte estiver fora do ar.
model Lot {
  id                 String    @id @default(uuid()) @db.Uuid
  auctioneerId       String    @map("auctioneer_id") @db.Uuid
  winningBidderId    String?   @map("winning_bidder_id") @db.Uuid
  title              String    @db.VarChar(200)
  description        String?   @db.Text
  externalItemId     String    @map("external_item_id") @db.VarChar(100)
  imageUrl           String    @map("image_url") @db.Text
  /// Snapshot dos atributos da obra (artista, data, técnica, dimensões, etc.)
  itemAttributes     Json      @map("item_attributes")
  startPriceCents    BigInt    @map("start_price_cents")
  minIncrementCents  BigInt    @map("min_increment_cents")
  /// Lance atual (denormalizado para consultas rápidas; validado contra os lances)
  currentPriceCents  BigInt    @map("current_price_cents")
  startsAt           DateTime  @map("starts_at")
  endsAt             DateTime  @map("ends_at")
  /// Fim original antes de qualquer prorrogação anti-sniping
  originalEndsAt     DateTime  @map("original_ends_at")
  status             LotStatus @default(SCHEDULED)
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  auctioneer    User      @relation("AuctioneerLots", fields: [auctioneerId], references: [id], onDelete: Restrict)
  winningBidder User?     @relation("WinningBidderLots", fields: [winningBidderId], references: [id], onDelete: SetNull)
  bids          Bid[]
  receipt       Receipt?

  @@index([status, startsAt, endsAt])
  @@index([auctioneerId])
  @@map("lots")
}

/// Lance registrado no leilão.
/// Forma uma cadeia de hashes criptográfica (tamper-proof hash chain),
/// garantindo que qualquer inserção, deleção ou modificação manual seja detectada.
model Bid {
  id             String   @id @default(uuid()) @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  bidderId       String   @map("bidder_id") @db.Uuid
  amountCents    BigInt   @map("amount_cents")
  previousBidId  String?  @map("previous_bid_id") @db.Uuid
  previousHash   String?  @map("previous_hash") @db.VarChar(64)
  hash           String   @db.VarChar(64)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  lot    Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bidder User @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  @@index([lotId, amountCents(sort: Desc)])
  @@index([lotId, createdAt(sort: Asc)])
  @@index([bidderId])
  @@map("bids")
}

/// Comprovante público de arremate de lote.
/// Gerado na liquidação com assinatura/hash de autenticidade verificável.
model Receipt {
  id               String   @id @default(uuid()) @db.Uuid
  lotId            String   @unique @map("lot_id") @db.Uuid
  winnerId         String   @map("winner_id") @db.Uuid
  auctioneerId     String   @map("auctioneer_id") @db.Uuid
  finalPriceCents  BigInt   @map("final_price_cents")
  receiptNumber    String   @unique @map("receipt_number") @db.VarChar(50)
  verificationHash String   @map("verification_hash") @db.VarChar(64)
  itemSnapshot     Json     @map("item_snapshot")
  settledAt        DateTime @default(now()) @map("settled_at")
  createdAt        DateTime @default(now()) @map("created_at")

  lot        Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  winner     User @relation("WinnerReceipts", fields: [winnerId], references: [id], onDelete: Restrict)
  auctioneer User @relation("AuctioneerReceipts", fields: [auctioneerId], references: [id], onDelete: Restrict)

  @@index([winnerId])
  @@index([auctioneerId])
  @@map("receipts")
}
