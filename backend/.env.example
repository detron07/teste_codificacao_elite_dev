# Copie para `.env` e ajuste conforme necessário: cp .env.example .env

# Ambiente: development | production | test
NODE_ENV=development
PORT=3000

# PostgreSQL (mesmos valores padrão do docker-compose.yml da raiz)
DATABASE_URL=postgresql://leilao:leilao@localhost:5432/casa_leiloes?schema=public

# Origem(ns) autorizada(s) do front-end, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Autenticação — use um valor longo e aleatório em produção
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=1d
